{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Portal": {
    "Version": "3.2.0",
    "SupportEmail": "hiredesk@ashfordhire.co.uk",
    "SessionIdleHours": 8
  },
  "Jwt": {
    "Issuer": "ashfordhire-api",
    "AllowUnsignedKioskTokens": true
  },
  "Telematics": {
    "ApiBase": "https://api.traknet.example/v3",
    "SyncEndpoint": "http://127.0.0.1:8080/internal/telematics/config"
  },
  "Webhooks": {
    "BlockedHosts": [ "localhost", "127.0.0.1", "[::1]", "::1", "169.254.169.254", "metadata.google.internal" ],
    "TimeoutSeconds": 6
  }
}
