@{
    ViewData["Title"] = "Sign in";
    var registered = Context.Request.Query["registered"] == "1";
}
<section class="wrap auth-wrap">
    <div class="card auth-card">
        <h1>Sign in</h1>
        <p class="muted">Customer and depot staff accounts.</p>
        @if (registered)
        {
            <div class="alert alert-success">Your account is ready. Sign in to start hiring.</div>
        }
        @if (ViewBag.Error != null)
        {
            <div class="alert alert-error">@ViewBag.Error</div>
        }
        <form method="post" asp-antiforgery="true" action="/signin" class="form-stack">
            <input type="hidden" name="returnUrl" value="@ViewBag.ReturnUrl">
            <div class="field">
                <label for="username">Username</label>
                <input id="username" name="username" value="@ViewBag.Username" autocomplete="username" required autofocus>
            </div>
            <div class="field">
                <label for="password">Password</label>
                <input id="password" name="password" type="password" autocomplete="current-password" required>
            </div>
            <button class="btn btn-primary btn-block" type="submit">Sign in</button>
        </form>
        <div class="auth-links">
            <a href="/account/recover">Forgotten your password?</a>
            <a href="/register">Open an account</a>
        </div>
    </div>
</section>
