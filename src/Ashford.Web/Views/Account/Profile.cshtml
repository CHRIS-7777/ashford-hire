@{
    ViewData["Title"] = "Profile";
}
<section class="wrap section account">
    <partial name="_AccountNav" />
    <div class="account-main">
        <h1>Profile</h1>
        <div class="card">
            <div data-profile-status></div>
            <form class="form-stack" data-profile-form>
                <div class="form-row">
                    <div class="field">
                        <label for="p-name">Full name</label>
                        <input id="p-name" name="fullName" required>
                    </div>
                    <div class="field">
                        <label for="p-company">Company</label>
                        <input id="p-company" name="company">
                    </div>
                </div>
                <div class="form-row">
                    <div class="field">
                        <label for="p-email">Email</label>
                        <input id="p-email" name="email" type="email" required>
                    </div>
                    <div class="field">
                        <label for="p-phone">Phone</label>
                        <input id="p-phone" name="phone">
                    </div>
                </div>
                <div class="form-row">
                    <div class="field">
                        <label>Username</label>
                        <input name="username" disabled>
                    </div>
                    <div class="field">
                        <label>Account type</label>
                        <input name="accountType" disabled>
                    </div>
                </div>
                <button class="btn btn-primary" type="submit">Save changes</button>
            </form>
        </div>
        <p class="muted small">Want trade pricing? Ask your depot to upgrade your account once your first hire is complete.</p>
    </div>
</section>
