@model List<Hire>
@{
    ViewData["Title"] = "Hires";
}
<section class="wrap section account">
    <partial name="_AccountNav" />
    <div class="account-main">
        <h1>Hires</h1>
        @if (Model.Count == 0)
        {
            <div class="card muted">You haven't hired anything yet.</div>
        }
        else
        {
            <div class="card">
                <table class="table">
                    <thead><tr><th>Ref</th><th>Equipment</th><th>Dates</th><th>Site</th><th>Status</th><th class="num">Total</th></tr></thead>
                    <tbody>
                    @foreach (var h in Model)
                    {
                        <tr>
                            <td><a href="/my/hires/@h.Id">@h.Ref</a></td>
                            <td>@h.EquipmentName</td>
                            <td>@h.StartDate.ToString("dd MMM") &ndash; @h.EndDate.ToString("dd MMM yyyy")</td>
                            <td>@h.DeliveryPostcode</td>
                            <td><span class="status status-@h.Status.Replace(" ", "-").ToLowerInvariant()">@h.Status</span></td>
                            <td class="num">&pound;@h.Total.ToString("0.00")</td>
                        </tr>
                    }
                    </tbody>
                </table>
            </div>
        }
    </div>
</section>
